<Window x:Class="EchoPlayer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EchoPlayer.Desktop"
        xmlns:controls="clr-namespace:EchoPlayer.Desktop.Controls"
        xmlns:vm="clr-namespace:EchoPlayer.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Echo Player"
        Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        AllowDrop="True">

  <Window.Resources>
    <local:VisibleWhenConverter x:Key="VisibleWhen" />
    <local:SameConverter x:Key="Same" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}" />
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ProcessAllCommand}" />
  </Window.InputBindings>

  <Grid Margin="28,18,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddFilesCommand}" ToolTip="Add WAV files (Ctrl+O)"
                AutomationProperties.AutomationId="AddFilesButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
            <TextBlock Text="Add files" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearFilesCommand}" ToolTip="Remove every file from the list"
                AutomationProperties.AutomationId="ClearButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" Margin="0,0,8,0" />
            <TextBlock Text="Clear" />
          </StackPanel>
        </Button>

        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ProcessAllCommand}" Margin="12,0,0,0" Padding="14,6"
                ToolTip="Write every file with the echo (Ctrl+Enter)" AutomationProperties.AutomationId="ProcessButton"
                Visibility="{Binding ProcessAllCommand.IsRunning, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
            <TextBlock Text="Process all" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ProcessAllCancelCommand}" Margin="12,0,0,0" Padding="14,6"
                Visibility="{Binding ProcessAllCommand.IsRunning, Converter={StaticResource VisibleWhen}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,8,0" />
            <TextBlock Text="Stop" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Echo Player" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Caption}" Text="Add a feedback echo to WAV recordings, hear it, then save it" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4*" MinWidth="340" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="7*" MinWidth="560" />
      </Grid.ColumnDefinitions>

      <!-- Files -->
      <Border Style="{StaticResource Card}" Padding="0,16,0,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="20,0,20,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    Visibility="{Binding HasFiles, Converter={StaticResource VisibleWhen}}">
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Files.Count}" />
            </Border>
            <TextBlock Style="{StaticResource CardTitle}" Text="Files" />
          </DockPanel>

          <!-- Output folder and the result of the last run -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,14,20,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="Save to" />
              <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Save next to each original again"
                        Command="{Binding ResetOutputFolderCommand}"
                        Visibility="{Binding HasCustomOutputFolder, Converter={StaticResource VisibleWhen}}" />
                <Button DockPanel.Dock="Right" Content="Change…" Padding="10,4" Margin="8,0,4,0" Command="{Binding ChooseOutputFolderCommand}" />
                <TextBlock Text="{Binding OutputFolderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding OutputFolderText}" />
              </DockPanel>
              <DockPanel Margin="0,12,0,0" Visibility="{Binding Summary, Converter={StaticResource VisibleWhen}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Margin="0" Padding="8,4" Command="{Binding OpenOutputFolderCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,6,0" FontSize="12" />
                    <TextBlock Text="Open folder" />
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="SummaryText" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Grid>
            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                        Visibility="{Binding HasFiles, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="40" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Text="Drop WAV files here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
              <TextBlock Style="{StaticResource Caption}" Text="or use Add files. You can add as many as you like." TextAlignment="Center" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                     BorderThickness="0" Background="Transparent" Padding="8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.AutomationId="FileList"
                     Visibility="{Binding HasFiles, Converter={StaticResource VisibleWhen}}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="12,10" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AudioFileViewModel}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove from the list"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />

                    <!-- Status icon -->
                    <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top">
                      <Border CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" HorizontalAlignment="Center" FontSize="14"
                                 Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}" />
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" HorizontalAlignment="Center" FontSize="16"
                                 Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                 Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}}" />
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" HorizontalAlignment="Center" FontSize="16"
                                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                 Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}}" />
                      <ProgressBar IsIndeterminate="True" Width="20" MinWidth="0" Margin="6"
                                   Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                    </Grid>

                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,6,0,0" MinWidth="0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Message}" Margin="0,2,0,0"
                                 Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview -->
        <Border Style="{StaticResource Card}">
          <Grid>
            <TextBlock Style="{StaticResource Caption}" Text="Select a file to hear it with the echo." FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />

            <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedFile.Name}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="PreviewTitle" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedFile.Info.Description}" />
              </StackPanel>

              <!-- Transport -->
              <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" AutomationProperties.AutomationId="PlayButton"
                        AutomationProperties.Name="Play or pause">
                  <Button.Content>
                    <Grid>
                      <TextBlock Text="&#xF5B0;" Margin="3,0,0,0" Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                      <TextBlock Text="&#xF8AE;" Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                  </Button.Content>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" FontSize="16" Padding="10" Margin="10,0,0,0"
                        Command="{Binding StopCommand}" ToolTip="Stop" VerticalAlignment="Center" AutomationProperties.Name="Stop" />
                <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14">
                  <Run Text="{Binding PositionText, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=" / " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <ToggleButton IsChecked="{Binding IsEchoOn}" Padding="12,6" AutomationProperties.AutomationId="EchoToggle"
                                ToolTip="Compare: hear the original or the echo while it plays">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Margin="0,0,8,0" />
                      <TextBlock Text="Echo on" />
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>
              </DockPanel>

              <!-- Waveforms -->
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Caption}" Text="Original" Margin="0,0,0,4" />
                <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="0,4">
                  <controls:WaveformView Peaks="{Binding OriginalWaveform.Peaks}"
                                         LengthFraction="{Binding OriginalFraction}"
                                         PlayheadFraction="{Binding PlayheadFraction}"
                                         SeekCommand="{Binding SeekCommand}"
                                         WaveBrush="{StaticResource OriginalWaveBrush}"
                                         PlayedBrush="{StaticResource PlayedOriginalBrush}"
                                         PlayheadBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                         AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Border>

                <DockPanel Grid.Row="2" Margin="0,12,0,4">
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding EchoSummary}" />
                  <TextBlock Style="{StaticResource Caption}" Text="With echo" />
                </DockPanel>
                <Border Grid.Row="3" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="0,4">
                  <controls:WaveformView Peaks="{Binding EchoWaveform.Peaks}"
                                         PlayheadFraction="{Binding PlayheadFraction}"
                                         MarkerFraction="{Binding OriginalFraction}"
                                         SeekCommand="{Binding SeekCommand}"
                                         WaveBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                         PlayedBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                         UnplayedOpacity="0.5"
                                         PlayheadBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                         AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         AutomationProperties.AutomationId="EchoWaveform" />
                </Border>
              </Grid>
            </DockPanel>
          </Grid>
        </Border>

        <!-- Echo settings -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="Echo" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:EchoPreset}">
                  <Button Content="{Binding Name}" ToolTip="{Binding Description}"
                          AutomationProperties.AutomationId="{Binding Name, StringFormat=Preset{0}}"
                          Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource PresetButton}">
                        <Style.Triggers>
                          <DataTrigger Value="True">
                            <DataTrigger.Binding>
                              <MultiBinding Converter="{StaticResource Same}">
                                <Binding />
                                <Binding Path="DataContext.ActivePreset" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
              </Grid.RowDefinitions>

              <TextBlock Style="{StaticResource FieldLabel}" Text="Delay" ToolTip="Time between the sound and each repeat" />
              <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{Binding MinDelayMs}" Maximum="{Binding MaxDelayMs}"
                      Value="{Binding DelayMs}" SmallChange="10" LargeChange="100" TickFrequency="10" IsSnapToTickEnabled="True"
                      AutomationProperties.AutomationId="DelaySlider" />
              <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding DelayText}" />

              <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Feedback" ToolTip="How much each repeat feeds the next one: higher means more repeats" />
              <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="{Binding MaxFeedback}"
                      Value="{Binding Feedback}" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                      AutomationProperties.AutomationId="FeedbackSlider" />
              <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding FeedbackText}" />

              <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Mix" ToolTip="Loudness of the first repeat compared with the original" />
              <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1"
                      Value="{Binding Mix}" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                      AutomationProperties.AutomationId="MixSlider" />
              <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding MixText}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
